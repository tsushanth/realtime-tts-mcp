{
  "name": "realtime-tts-mcp",
  "version": "0.3.1",
  "mcpName": "io.github.tsushanth/realtime-tts-mcp",
  "description": "MCP server for ReadAloud's realtime streaming text-to-speech API: a synthesize_speech tool, plus the full lifecycle for streaming voice cloning. Free API key, 10,000 free characters, sub-second warm latency. Returns playable WAV audio.",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "realtime-tts-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && chmod +x dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsushanth/realtime-tts-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tts",
    "text-to-speech",
    "voice",
    "voice-cloning",
    "streaming",
    "readaloud",
    "elevenlabs-alternative"
  ]
}
